{
  "name": "grow-html",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "e2e": "playwright test",
    "e2e:headed": "playwright test --headed",
    "e2e:electron": "npm run electron:build && playwright test --config=playwright.electron.config.ts",
    "electron:build:main": "esbuild electron/main.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-electron/main.cjs",
    "electron:build:preload": "esbuild electron/preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/preload.cjs",
    "electron:build:webview-preload": "esbuild electron/webview-preload.ts --bundle --platform=node --format=cjs --external:electron --outfile=dist-electron/webview-preload.cjs",
    "electron:build": "vite build && npm run electron:build:main && npm run electron:build:preload && npm run electron:build:webview-preload",
    "electron": "npm run electron:build && node scripts/launch-electron.cjs",
    "electron:dev": "npm run electron:build:main && npm run electron:build:preload && npm run electron:build:webview-preload && node scripts/launch-electron.cjs --dev",
    "electron:rebuild": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "latest",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/source-serif-4": "^5.2.9",
    "@vitejs/plugin-react": "latest",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "latest",
    "fflate": "^0.8.3",
    "grapesjs": "latest",
    "grapesjs-preset-webpage": "latest",
    "linkedom": "^0.18.12",
    "lucide-react": "^1.21.0",
    "markmap-lib": "^0.18.12",
    "markmap-view": "^0.18.12",
    "mermaid": "^11.15.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.0.227",
    "react": "latest",
    "react-dom": "latest",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@playwright/test": "^1.61.0",
    "@types/express": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/supertest": "^7.2.0",
    "concurrently": "latest",
    "electron": "^42.4.1",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "rcedit": "^5.0.2",
    "supertest": "^7.2.2",
    "tsx": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "^4.1.9"
  }
}
