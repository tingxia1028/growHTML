# Optional. If omitted, the SDK will use its bundled binary or try to resolve `claude` from PATH.
CLAUDE_CODE_EXECUTABLE=

# Optional. If omitted, GrowHTML will resolve `codex` from PATH.
CODEX_EXECUTABLE=

# Optional. Claude Agent SDK usually needs Anthropic auth available in the environment.
ANTHROPIC_API_KEY=

# Optional. Codex exec supports CODEX_API_KEY for a single automation-style invocation.
CODEX_API_KEY=
